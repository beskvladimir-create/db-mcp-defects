  {
   "name": "analyze_text",
   "description": "Analyze text to see how it would be tokenized.\n\nUse this tool to understand how Elasticsearch/OpenSearch tokenizes and\ntransforms text using analyzers. This is essential for debugging search\nqueries and understanding why certain documents match or don't match.",
   "inputSchema": {
    "additionalProperties": false,
    "properties": {
     "text": {
      "type": "string",
      "description": "The text to analyze"
     },
     "index": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Index name to use its configured analyzer. If not specified,\n   uses cluster-level analysis with built-in analyzers only."
     },
     "analyzer": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Name of the analyzer to use (e.g., 'standard', 'korean',\n     'korean_search'). If index is specified, you can use\n     custom analyzers defined in that index."
     },
     "tokenizer": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Tokenizer to use for custom analysis chain. Cannot be\n      used together with 'analyzer'."
     },
     "filter": {
      "anyOf": [
       {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "List of token filters to apply (e.g., ['lowercase', 'stop']).\n   Used with 'tokenizer' for custom analysis chain."
     },
     "char_filter": {
      "anyOf": [
       {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "List of character filters to apply before tokenization.\n        Used with 'tokenizer' for custom analysis chain."
     },
     "explain": {
      "default": false,
      "type": "boolean",
      "description": "If True, returns detailed information about each token\n    including all token attributes and filter transformations.\n    Useful for debugging complex analyzer chains."
     },
     "attributes": {
      "anyOf": [
       {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "List of token attributes to return when explain=True\n       (e.g., ['keyword', 'type']). If not specified, all\n       attributes are returned."
     },
     "cluster": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Optional cluster name. Uses the default cluster if omitted."
     }
    },
    "required": [
     "text"
    ],
    "type": "object"
   },
   "outputSchema": {
    "additionalProperties": true,
    "type": "object"
   },
   "_meta": {
    "fastmcp": {
     "tags": []
    }
   }
  }
